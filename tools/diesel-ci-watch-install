#!/data/data/com.termux/files/usr/bin/bash

diesel_ci_watch_download_install() {
  REPO="bloom11/dieselbridge"
  WORKFLOW="ci.yml"
  WATCH_ARTIFACT="dieselbridge-bloom-debug"
  PHONE_ARTIFACT="dieselbridge-phone-bloom-debug"
  WATCH_PACKAGE="io.github.bloom11.dieselbridge"

  DOWNLOAD_ONLY=0
  OPEN_PHONE_INSTALLER=0
  FORCE_DOWNLOAD=0

  for ARG in "$@"; do
    case "$ARG" in
      --download-only)
        DOWNLOAD_ONLY=1
        ;;
      --open-phone-installer)
        OPEN_PHONE_INSTALLER=1
        ;;
      --force-download)
        FORCE_DOWNLOAD=1
        ;;
      -h|--help)
        echo "Usage:"
        echo "  ./tools/diesel-ci-watch-install [--download-only] [--open-phone-installer] [--force-download]"
        echo
        echo "Default: reuse valid exact-SHA cached artifacts independently; download only missing/mismatched sides; then install the watch."
        echo "--download-only: prepare both exact-SHA artifacts without watch ADB/install."
        echo "--open-phone-installer: verify Downloads copy, then open Android installer."
        echo "--force-download: ignore valid watch/phone caches and redownload both."
        return 0
        ;;
      *)
        echo "ERROR: unknown argument: $ARG"
        return 2
        ;;
    esac
  done

  ROOT=""

  # Prefer an explicit checkout, then the checkout containing this script,
  # then the caller's current checkout. git rev-parse supports both ordinary
  # clones (.git directory) and linked worktrees (.git file).
  if [ -n "${DIESEL_REPO_ROOT:-}" ]; then
    ROOT="$(git -C "$DIESEL_REPO_ROOT" rev-parse --show-toplevel 2>/dev/null || true)"
  fi

  if [ -z "$ROOT" ]; then
    SCRIPT_DIR="$(cd "$(dirname "$0")" 2>/dev/null && pwd)"
    ROOT="$(git -C "$SCRIPT_DIR" rev-parse --show-toplevel 2>/dev/null || true)"
  fi

  if [ -z "$ROOT" ]; then
    ROOT="$(git -C "$PWD" rev-parse --show-toplevel 2>/dev/null || true)"
  fi

  if [ -z "$ROOT" ]; then
    for CANDIDATE in "$HOME/dieselbridge-project/repo" "$HOME/dieselbridge"; do
      if git -C "$CANDIDATE" rev-parse --show-toplevel >/dev/null 2>&1; then
        ROOT="$(git -C "$CANDIDATE" rev-parse --show-toplevel)"
        break
      fi
    done
  fi

  if [ -z "$ROOT" ]; then
    echo "ERROR: DieselBridge repo/worktree not found."
    echo "Run this tool from a DieselBridge checkout or set:"
    echo "  DIESEL_REPO_ROOT=/path/to/checkout"
    return 1
  fi

  cd "$ROOT" || return 1

  printf '\n===== PREFLIGHT =====\n'

  for CMD in git gh find; do
    if ! command -v "$CMD" >/dev/null 2>&1; then
      echo "ERROR: missing command: $CMD"
      return 1
    fi
  done

  if [ "$DOWNLOAD_ONLY" -ne 1 ] &&
     ! command -v adb >/dev/null 2>&1; then
    echo "ERROR: missing command: adb"
    return 1
  fi

  if [ "$OPEN_PHONE_INSTALLER" -eq 1 ] &&
     ! command -v termux-open >/dev/null 2>&1; then
    echo "ERROR: --open-phone-installer requires termux-open."
    return 1
  fi

  if ! gh auth status >/dev/null 2>&1; then
    echo "ERROR: GitHub CLI is not authenticated."
    echo "Run:"
    echo "  gh auth login"
    return 1
  fi

  DIRTY_STATUS="$(git status --porcelain)"

  if [ -n "$DIRTY_STATUS" ]; then
    DIRTY_PATHS="$(
      {
        git diff --name-only
        git diff --cached --name-only
        git ls-files --others --exclude-standard
      } |
        sed '/^$/d' |
        sort -u
    )"

    if [ "${DIESEL_ALLOW_DIRTY_INSTALLER:-0}" = "1" ] &&
       [ "$DIRTY_PATHS" = "tools/diesel-ci-watch-install" ]; then
      echo "NOTE: allowing the local installer-only development patch."
      echo "Exact application source HEAD remains unchanged."
    else
      echo "ERROR: repository has uncommitted changes."
      echo
      git status --short
      echo
      echo "Commit/push or restore the current work before using this installer."
      echo
      echo "For the temporary local installer-only patch, use:"
      echo "  DIESEL_ALLOW_DIRTY_INSTALLER=1 ./tools/diesel-ci-watch-install"
      return 1
    fi
  fi

  BRANCH="$(git branch --show-current)"
  HEAD="$(git rev-parse HEAD)"
  SHORT="$(git rev-parse --short=8 HEAD)"

  if [ -z "$BRANCH" ]; then
    echo "ERROR: detached HEAD."
    return 1
  fi

  echo "Branch: $BRANCH"
  echo "Commit: $HEAD"

  printf '\n===== VERIFY COMMIT IS PUSHED =====\n'

  REMOTE_HEAD="$(
    git ls-remote \
      origin \
      "refs/heads/$BRANCH" |
      awk '{print $1}'
  )"

  if [ -z "$REMOTE_HEAD" ]; then
    echo "ERROR: could not resolve origin/$BRANCH"
    return 1
  fi

  echo "Remote: $REMOTE_HEAD"

  if [ "$HEAD" != "$REMOTE_HEAD" ]; then
    echo "ERROR: local HEAD is not the pushed branch HEAD."
    echo
    echo "Local : $HEAD"
    echo "Remote: $REMOTE_HEAD"
    echo
    echo "Push first:"
    echo "  git push origin $BRANCH"
    return 1
  fi

  printf '\n===== WAIT FOR CI RUN =====\n'

  RUN_ID=""
  ATTEMPT=0

  while [ "$ATTEMPT" -lt 120 ]; do
    ATTEMPT=$((ATTEMPT + 1))

    RUN_ID="$(
      gh run list \
        --repo "$REPO" \
        --workflow "$WORKFLOW" \
        --commit "$HEAD" \
        --limit 20 \
        --json databaseId,headSha \
        --jq \
        'map(select(.headSha == "'"$HEAD"'")) | first | .databaseId // empty'
    )"

    if [ -n "$RUN_ID" ]; then
      break
    fi

    printf 'Waiting for GitHub Actions run... (%d)\r' \
      "$ATTEMPT"

    sleep 5
  done

  echo

  if [ -z "$RUN_ID" ]; then
    echo "ERROR: no CI run appeared for:"
    echo "  $HEAD"
    return 1
  fi

  echo "Run ID: $RUN_ID"

  RUN_SHA="$(
    gh run view \
      "$RUN_ID" \
      --repo "$REPO" \
      --json headSha \
      --jq '.headSha'
  )"

  if [ "$RUN_SHA" != "$HEAD" ]; then
    echo "ERROR: CI run SHA does not match current HEAD."
    echo "Expected: $HEAD"
    echo "Actual  : $RUN_SHA"
    return 1
  fi

  printf '\n===== LIVE CI =====\n'

  gh run watch \
    "$RUN_ID" \
    --repo "$REPO" \
    --interval 5 \
    --exit-status

  WATCH_RC=$?

  if [ "$WATCH_RC" -ne 0 ]; then
    printf '\n===== RESOLVE CI STATE =====\n'
    echo "gh run watch returned non-zero; resolving remote state before declaring failure."

    STATE_ATTEMPT=0
    RESOLVED=0

    while [ "$STATE_ATTEMPT" -lt 12 ]; do
      STATE_ATTEMPT=$((STATE_ATTEMPT + 1))

      RUN_STATE="$(
        gh run view \
          "$RUN_ID" \
          --repo "$REPO" \
          --json headSha,status,conclusion \
          --jq '[.headSha,.status,(.conclusion // "")] | @tsv' \
          2>/dev/null
      )"

      if [ -n "$RUN_STATE" ]; then
        STATE_SHA="$(printf '%s' "$RUN_STATE" | cut -f1)"
        STATE_STATUS="$(printf '%s' "$RUN_STATE" | cut -f2)"
        STATE_CONCLUSION="$(printf '%s' "$RUN_STATE" | cut -f3)"

        if [ "$STATE_SHA" != "$HEAD" ]; then
          echo "ERROR: CI state resolved to unexpected SHA."
          echo "Expected: $HEAD"
          echo "Actual  : $STATE_SHA"
          return 1
        fi

        echo "Remote status: $STATE_STATUS"
        echo "Remote result: ${STATE_CONCLUSION:-pending}"

        if [ "$STATE_STATUS" = "completed" ]; then
          RESOLVED=1
          break
        fi
      else
        echo "GitHub API unavailable ($STATE_ATTEMPT/12)."
      fi

      sleep 5
    done

    if [ "$RESOLVED" -ne 1 ]; then
      echo "ERROR: could not resolve authoritative CI state."
      return 1
    fi

    if [ "$STATE_CONCLUSION" != "success" ]; then
      printf '\n===== CI FAILED =====\n'
      gh run view "$RUN_ID" --repo "$REPO" --log-failed || true
      return 1
    fi

    echo "CI succeeded; continuing after the local network interruption."
  fi

  printf '\n===== CI SUCCESS =====\n'

  gh run view \
    "$RUN_ID" \
    --repo "$REPO" \
    --json \
      workflowName,headBranch,headSha,status,conclusion,url \
    --jq '
      "Workflow : \(.workflowName)\n" +
      "Branch   : \(.headBranch)\n" +
      "SHA      : \(.headSha)\n" +
      "Status   : \(.status)\n" +
      "Result   : \(.conclusion)\n" +
      "URL      : \(.url)"
    '

  if [ -n "${DIESEL_BUILD_ROOT:-}" ]; then
    BUILD_ROOT="$DIESEL_BUILD_ROOT"
  elif [ -d "$HOME/dieselbridge-project/artifacts" ]; then
    BUILD_ROOT="$HOME/dieselbridge-project/artifacts/builds"
  else
    BUILD_ROOT="$HOME/dieselbridge-builds"
  fi

  BUILD_DIR="$BUILD_ROOT/${SHORT}-run-${RUN_ID}"
  WATCH_DIR="$BUILD_DIR/watch"
  PHONE_DIR="$BUILD_DIR/phone"
  TEMP_DIR="$BUILD_DIR/.download-$$"

  printf '\n===== EXACT-SHA ARTIFACT CACHE =====\n'
  echo "Build root: $BUILD_DIR"
  echo "Watch     : $WATCH_DIR"
  echo "Phone     : $PHONE_DIR"

  artifact_write_provenance() {
    ARTIFACT_DIR="$1"
    ARTIFACT_NAME="$2"
    APK_PATH="$3"
    MARKER="$ARTIFACT_DIR/.diesel-artifact-provenance"
    APK_FILE="$(basename "$APK_PATH")"
    APK_SHA=""

    if command -v sha256sum >/dev/null 2>&1; then
      APK_SHA="$(sha256sum "$APK_PATH" | awk '{print $1}')"
    fi

    {
      echo "gitSha=$HEAD"
      echo "runId=$RUN_ID"
      echo "artifactName=$ARTIFACT_NAME"
      echo "apkFile=$APK_FILE"
      echo "apkSha256=$APK_SHA"
    } > "$MARKER"
  }

  artifact_reuse_cached() {
    ARTIFACT_DIR="$1"
    ARTIFACT_NAME="$2"
    LABEL="$3"

    [ -d "$ARTIFACT_DIR" ] || return 1

    APK_COUNT="$(
      find "$ARTIFACT_DIR" -maxdepth 3 -type f -name '*.apk' |
        wc -l |
        tr -d '[:space:]'
    )"

    [ "$APK_COUNT" -eq 1 ] || return 1

    CACHED_APK="$(
      find "$ARTIFACT_DIR" -maxdepth 3 -type f -name '*.apk' |
        head -n1
    )"

    [ -s "$CACHED_APK" ] || return 1

    MARKER="$ARTIFACT_DIR/.diesel-artifact-provenance"

    if [ -f "$MARKER" ]; then
      MARKER_SHA="$(sed -n 's/^gitSha=//p' "$MARKER" | head -n1)"
      MARKER_RUN="$(sed -n 's/^runId=//p' "$MARKER" | head -n1)"
      MARKER_ARTIFACT="$(sed -n 's/^artifactName=//p' "$MARKER" | head -n1)"
      MARKER_APK="$(sed -n 's/^apkFile=//p' "$MARKER" | head -n1)"
      MARKER_APK_SHA="$(sed -n 's/^apkSha256=//p' "$MARKER" | head -n1)"

      if [ "$MARKER_SHA" != "$HEAD" ] ||
         [ "$MARKER_RUN" != "$RUN_ID" ] ||
         [ "$MARKER_ARTIFACT" != "$ARTIFACT_NAME" ] ||
         [ "$MARKER_APK" != "$(basename "$CACHED_APK")" ]; then
        echo "$LABEL cache provenance does not match current exact SHA/run."
        return 1
      fi

      if [ -n "$MARKER_APK_SHA" ] &&
         command -v sha256sum >/dev/null 2>&1; then
        CURRENT_APK_SHA="$(sha256sum "$CACHED_APK" | awk '{print $1}')"
        if [ "$CURRENT_APK_SHA" != "$MARKER_APK_SHA" ]; then
          echo "$LABEL cached APK SHA-256 no longer matches its provenance marker."
          return 1
        fi
      fi
    else
      echo "$LABEL cache is in the canonical exact-SHA/run directory."
      echo "Adopting legacy cache once and writing local provenance."
      artifact_write_provenance \
        "$ARTIFACT_DIR" \
        "$ARTIFACT_NAME" \
        "$CACHED_APK"
    fi

    echo "Reusing $LABEL exact-SHA artifact:"
    echo "  $CACHED_APK"
    return 0
  }

  artifact_download_one() {
    ARTIFACT_NAME="$1"
    LABEL="$2"
    TARGET_DIR="$3"
    TEMP_SUBDIR="$4"

    rm -rf "$TEMP_SUBDIR"
    mkdir -p "$TEMP_SUBDIR"

    printf '\nDownloading %s artifact: %s\n' "$LABEL" "$ARTIFACT_NAME"

    gh run download \
      "$RUN_ID" \
      --repo "$REPO" \
      --name "$ARTIFACT_NAME" \
      --dir "$TEMP_SUBDIR"

    DOWNLOAD_RC=$?

    if [ "$DOWNLOAD_RC" -ne 0 ]; then
      echo "ERROR: $LABEL artifact download failed."
      return "$DOWNLOAD_RC"
    fi

    APK_COUNT="$(
      find "$TEMP_SUBDIR" -maxdepth 3 -type f -name '*.apk' |
        wc -l |
        tr -d '[:space:]'
    )"

    if [ "$APK_COUNT" -ne 1 ]; then
      echo "ERROR: expected exactly one $LABEL APK; found $APK_COUNT"
      find "$TEMP_SUBDIR" -maxdepth 3 -type f
      return 1
    fi

    DOWNLOADED_APK="$(
      find "$TEMP_SUBDIR" -maxdepth 3 -type f -name '*.apk' |
        head -n1
    )"

    if [ ! -s "$DOWNLOADED_APK" ]; then
      echo "ERROR: downloaded $LABEL APK is empty."
      return 1
    fi

    mkdir -p "$BUILD_DIR"
    rm -rf "$TARGET_DIR"
    mv "$TEMP_SUBDIR" "$TARGET_DIR"

    FINAL_APK="$(
      find "$TARGET_DIR" -maxdepth 3 -type f -name '*.apk' |
        head -n1
    )"

    artifact_write_provenance \
      "$TARGET_DIR" \
      "$ARTIFACT_NAME" \
      "$FINAL_APK"

    DOWNLOADED_APK="$FINAL_APK"
  }

  WATCH_NEEDS_DOWNLOAD=1
  PHONE_NEEDS_DOWNLOAD=1
  WATCH_SOURCE="download"
  PHONE_SOURCE="download"
  WATCH_APK=""
  PHONE_APK=""

  if [ "$FORCE_DOWNLOAD" -ne 1 ]; then
    if artifact_reuse_cached "$WATCH_DIR" "$WATCH_ARTIFACT" "watch"; then
      WATCH_APK="$CACHED_APK"
      WATCH_NEEDS_DOWNLOAD=0
      WATCH_SOURCE="cache"
    fi

    if artifact_reuse_cached "$PHONE_DIR" "$PHONE_ARTIFACT" "phone"; then
      PHONE_APK="$CACHED_APK"
      PHONE_NEEDS_DOWNLOAD=0
      PHONE_SOURCE="cache"
    fi
  else
    echo "Forced redownload requested for both artifacts."
  fi

  if [ "$WATCH_NEEDS_DOWNLOAD" -eq 1 ] ||
     [ "$PHONE_NEEDS_DOWNLOAD" -eq 1 ]; then
    rm -rf "$TEMP_DIR"
    mkdir -p "$TEMP_DIR"
  fi

  if [ "$WATCH_NEEDS_DOWNLOAD" -eq 1 ]; then
    if ! artifact_download_one \
      "$WATCH_ARTIFACT" \
      "watch" \
      "$WATCH_DIR" \
      "$TEMP_DIR/watch"; then
      rm -rf "$TEMP_DIR"
      return 1
    fi
    WATCH_APK="$DOWNLOADED_APK"
  fi

  if [ "$PHONE_NEEDS_DOWNLOAD" -eq 1 ]; then
    if ! artifact_download_one \
      "$PHONE_ARTIFACT" \
      "phone" \
      "$PHONE_DIR" \
      "$TEMP_DIR/phone"; then
      rm -rf "$TEMP_DIR"
      return 1
    fi
    PHONE_APK="$DOWNLOADED_APK"
  fi

  rm -rf "$TEMP_DIR"

  if [ -z "$WATCH_APK" ] || [ ! -s "$WATCH_APK" ]; then
    echo "ERROR: exact-SHA watch APK is unavailable."
    return 1
  fi

  if [ -z "$PHONE_APK" ] || [ ! -s "$PHONE_APK" ]; then
    echo "ERROR: exact-SHA phone APK is unavailable."
    return 1
  fi

  printf '\n===== EXACT-SHA WATCH APK =====\n'
  echo "Source: $WATCH_SOURCE"
  echo "$WATCH_APK"
  ls -lh "$WATCH_APK"

  printf '\n===== EXACT-SHA PHONE APK =====\n'
  echo "Source: $PHONE_SOURCE"
  echo "$PHONE_APK"
  ls -lh "$PHONE_APK"

  if command -v sha256sum >/dev/null 2>&1; then
    printf '\nWatch SHA-256:\n'
    sha256sum "$WATCH_APK"
    printf '\nPhone SHA-256:\n'
    sha256sum "$PHONE_APK"
  fi

  PHONE_DOWNLOAD_COPY=""
  PHONE_DOWNLOAD_DIR="$HOME/storage/downloads/DieselBridge/Companion"

  if [ -d "$HOME/storage/downloads" ]; then
    if ! mkdir -p "$PHONE_DOWNLOAD_DIR"; then
      echo "ERROR: could not create companion Downloads directory:"
      echo "  $PHONE_DOWNLOAD_DIR"
      return 1
    fi

    PHONE_DOWNLOAD_COPY="$PHONE_DOWNLOAD_DIR/DieselBridge-Companion-${SHORT}-run-${RUN_ID}.apk"

    printf '\n===== PREPARE COMPANION ANDROID DOWNLOADS COPY =====\n'
    echo "Source : $PHONE_APK"
    echo "Target : $PHONE_DOWNLOAD_COPY"

    COPY_REQUIRED=1

    if [ -s "$PHONE_DOWNLOAD_COPY" ]; then
      SOURCE_BYTES="$(wc -c < "$PHONE_APK" | tr -d '[:space:]')"
      COPY_BYTES="$(wc -c < "$PHONE_DOWNLOAD_COPY" | tr -d '[:space:]')"

      if [ "$SOURCE_BYTES" = "$COPY_BYTES" ]; then
        if command -v sha256sum >/dev/null 2>&1; then
          SOURCE_SHA="$(sha256sum "$PHONE_APK" | awk '{print $1}')"
          COPY_SHA="$(sha256sum "$PHONE_DOWNLOAD_COPY" | awk '{print $1}')"

          if [ "$SOURCE_SHA" = "$COPY_SHA" ]; then
            COPY_REQUIRED=0
          fi
        else
          COPY_REQUIRED=0
        fi
      fi
    fi

    if [ "$COPY_REQUIRED" -eq 0 ]; then
      echo "Reusing existing verified companion Downloads copy."
    else
      if ! cp -f "$PHONE_APK" "$PHONE_DOWNLOAD_COPY"; then
        echo "ERROR: companion copy failed."
        return 1
      fi
    fi

    if [ ! -s "$PHONE_DOWNLOAD_COPY" ]; then
      echo "ERROR: copied companion APK is missing or empty."
      return 1
    fi

    SOURCE_BYTES="$(wc -c < "$PHONE_APK" | tr -d '[:space:]')"
    COPY_BYTES="$(wc -c < "$PHONE_DOWNLOAD_COPY" | tr -d '[:space:]')"

    if [ "$SOURCE_BYTES" != "$COPY_BYTES" ]; then
      echo "ERROR: copied companion APK size does not match source."
      echo "Source bytes: $SOURCE_BYTES"
      echo "Copy bytes  : $COPY_BYTES"
      return 1
    fi

    if command -v sha256sum >/dev/null 2>&1; then
      SOURCE_SHA="$(sha256sum "$PHONE_APK" | awk '{print $1}')"
      COPY_SHA="$(sha256sum "$PHONE_DOWNLOAD_COPY" | awk '{print $1}')"

      if [ "$SOURCE_SHA" != "$COPY_SHA" ]; then
        echo "ERROR: copied companion APK SHA-256 does not match source."
        echo "Source SHA: $SOURCE_SHA"
        echo "Copy SHA  : $COPY_SHA"
        return 1
      fi

      echo "Verified SHA-256: $COPY_SHA"
    fi

    printf '\n===== PHONE INSTALLER COPY READY =====\n'
    echo "$PHONE_DOWNLOAD_COPY"
    ls -lh "$PHONE_DOWNLOAD_COPY"
  else
    echo
    echo "NOTE: ~/storage/downloads is unavailable."
    echo "Run termux-setup-storage if you want an Android Downloads copy."
  fi

  if [ "$OPEN_PHONE_INSTALLER" -eq 1 ]; then
    if [ -z "$PHONE_DOWNLOAD_COPY" ] ||
       [ ! -s "$PHONE_DOWNLOAD_COPY" ]; then
      echo "ERROR: verified companion copy is unavailable."
      echo "Android installer will not be opened."
      return 1
    fi

    printf '\n===== OPEN PHONE INSTALLER AFTER VERIFIED COPY =====\n'
    echo "$PHONE_DOWNLOAD_COPY"

    if ! termux-open "$PHONE_DOWNLOAD_COPY"; then
      echo "ERROR: Android package installer could not be opened."
      echo "The verified APK remains at:"
      echo "  $PHONE_DOWNLOAD_COPY"
      return 1
    fi
  fi

  if [ "$DOWNLOAD_ONLY" -eq 1 ]; then
    printf '\n===== DOWNLOAD-ONLY COMPLETE =====\n'
    echo "Git SHA    : $HEAD"
    echo "CI run     : $RUN_ID"
    echo "Watch APK  : $WATCH_APK"
    echo "Phone APK  : $PHONE_APK"

    if [ -n "$PHONE_DOWNLOAD_COPY" ]; then
      echo "Phone copy : $PHONE_DOWNLOAD_COPY"
    fi

    return 0
  fi

  APK="$WATCH_APK"

  adb_connect_watch() {
    if [ -n "${DIESEL_ADB_SERIAL:-}" ]; then
      STATE="$(
        adb -s "$DIESEL_ADB_SERIAL" \
          get-state \
          2>/dev/null
      )"

      if [ "$STATE" = "device" ]; then
        ENDPOINT="$DIESEL_ADB_SERIAL"
        ADB_IP="${ENDPOINT%:*}"
        ADB_PORT="${ENDPOINT##*:}"

        echo
        echo "Using connected DIESEL_ADB_SERIAL:"
        echo "  $ENDPOINT"
        return 0
      fi
    fi

    EXISTING="$(
      adb devices |
        awk '
          NR > 1 &&
          $2 == "device" &&
          $1 ~ /^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+:[0-9]+$/ {
            print $1
            exit
          }
        '
    )"

    if [ -z "${ADB_IP:-}" ] &&
       [ -n "$EXISTING" ]; then
      ADB_IP="${EXISTING%:*}"
      ADB_PORT="${EXISTING##*:}"

      printf '\nExisting ADB watch: %s\n' "$EXISTING"
      printf 'Reuse it? [Y/n] '
      read -r REUSE

      case "$REUSE" in
        n|N|no|NO)
          ADB_IP=""
          ADB_PORT=""
          ;;
      esac
    fi

    while true; do
      printf '\n===== WATCH ADB CONNECTION =====\n'

      if [ -n "${ADB_IP:-}" ]; then
        printf 'Watch IP [%s]: ' "$ADB_IP"
      else
        printf 'Watch IP: '
      fi

      read -r NEW_IP

      if [ -n "$NEW_IP" ]; then
        ADB_IP="$NEW_IP"
      fi

      if [ -z "${ADB_IP:-}" ]; then
        echo "IP cannot be empty."
        continue
      fi

      if [ -n "${ADB_PORT:-}" ]; then
        printf 'ADB port [%s]: ' "$ADB_PORT"
      else
        printf 'ADB port: '
      fi

      read -r NEW_PORT

      if [ -n "$NEW_PORT" ]; then
        ADB_PORT="$NEW_PORT"
      fi

      if [ -z "${ADB_PORT:-}" ]; then
        echo "Port cannot be empty."
        continue
      fi

      ENDPOINT="$ADB_IP:$ADB_PORT"

      printf '\nConnecting to %s ...\n' "$ENDPOINT"

      adb connect "$ENDPOINT"

      sleep 1

      STATE="$(
        adb -s "$ENDPOINT" \
          get-state \
          2>/dev/null
      )"

      if [ "$STATE" = "device" ]; then
        echo "ADB connected: $ENDPOINT"
        return 0
      fi

      echo
      echo "ADB connection did not succeed."
      echo
      echo "Wear OS wireless-debugging ports can change."
      echo "Press Enter to retry the same IP/port, or type new values."
    done
  }

  ADB_IP=""
  ADB_PORT=""
  ENDPOINT=""

  adb_connect_watch || return 1

  printf '\n===== INSTALL WATCH APK =====\n'

  INSTALL_ATTEMPT=0
  INSTALL_OK=0

  while [ "$INSTALL_ATTEMPT" -lt 5 ]; do
    INSTALL_ATTEMPT=$((INSTALL_ATTEMPT + 1))

    printf '\nInstall attempt %d using %s\n' \
      "$INSTALL_ATTEMPT" \
      "$ENDPOINT"

    INSTALL_OUTPUT="$(
      adb -s "$ENDPOINT" \
        install -r "$APK" \
        2>&1
    )"

    INSTALL_RC=$?

    printf '%s\n' "$INSTALL_OUTPUT"

    if [ "$INSTALL_RC" -eq 0 ] &&
       printf '%s\n' "$INSTALL_OUTPUT" |
         grep -q 'Success'; then
      INSTALL_OK=1
      break
    fi

    case "$INSTALL_OUTPUT" in
      *"device offline"*|\
      *"device not found"*|\
      *"no devices/emulators found"*|\
      *"closed"*|\
      *"Connection reset"*|\
      *"cannot connect"*)
        echo
        echo "ADB connection was lost."
        echo "Reconnect using the current watch Wireless debugging endpoint."

        adb_connect_watch || return 1
        ;;

      *)
        echo
        echo "ERROR: installation failed for a non-connection reason."
        echo "Not retrying automatically."
        return 1
        ;;
    esac
  done

  if [ "$INSTALL_OK" -ne 1 ]; then
    echo "ERROR: install did not succeed after 5 attempts."
    return 1
  fi

  sleep 2

  printf '\n===== INSTALLED PACKAGE =====\n'

  adb -s "$ENDPOINT" \
    shell dumpsys package "$WATCH_PACKAGE" |
    grep -E \
      'versionCode=|versionName=|firstInstallTime=|lastUpdateTime='

  printf '\n===== BUILD USED =====\n'
  echo "Git SHA   : $HEAD"
  echo "CI run    : $RUN_ID"
  echo "Watch APK : $WATCH_APK"
  echo "Phone APK : $PHONE_APK"
  echo "ADB       : $ENDPOINT"

  if [ -n "$PHONE_DOWNLOAD_COPY" ]; then
    echo "Phone copy: $PHONE_DOWNLOAD_COPY"
  fi

  printf '\n===== DONE =====\n'
  echo "Watch APK installed successfully."
  echo "The exact-SHA companion APK was downloaded from the same CI run."

  if [ -n "$PHONE_DOWNLOAD_COPY" ]; then
    echo
    echo "Companion APK ready:"
    echo "  $PHONE_DOWNLOAD_COPY"
    echo
    echo "Open it with:"
    echo "  termux-open \"$PHONE_DOWNLOAD_COPY\""
  fi

  echo
  echo "Next useful watch test:"
  echo "  cd $ROOT"
  echo "  ./tools/diesel-adb '{\"cmd\":\"debug.build.info\"}'"

  return 0
}

diesel_ci_watch_download_install "$@"
