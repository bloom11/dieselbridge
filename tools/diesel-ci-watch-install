#!/data/data/com.termux/files/usr/bin/bash

diesel_ci_watch_download_install() {
  REPO="bloom11/dieselbridge"
  WORKFLOW="ci.yml"
  WATCH_ARTIFACT="dieselbridge-bloom-debug"
  PHONE_ARTIFACT="dieselbridge-phone-bloom-debug"
  WATCH_PACKAGE="io.github.bloom11.dieselbridge"

  DOWNLOAD_ONLY=0
  OPEN_PHONE_INSTALLER=0

  for ARG in "$@"; do
    case "$ARG" in
      --download-only)
        DOWNLOAD_ONLY=1
        ;;
      --open-phone-installer)
        OPEN_PHONE_INSTALLER=1
        ;;
      -h|--help)
        echo "Usage:"
        echo "  ./tools/diesel-ci-watch-install [--download-only] [--open-phone-installer]"
        echo
        echo "Default: download exact-SHA watch + phone artifacts, then install the watch."
        echo "--download-only: download both artifacts without watch ADB/install."
        echo "--open-phone-installer: open Android installer for the downloaded companion."
        return 0
        ;;
      *)
        echo "ERROR: unknown argument: $ARG"
        return 2
        ;;
    esac
  done

  ROOT=""

  # Prefer an explicit checkout, then the checkout containing this script,
  # then the caller's current checkout. git rev-parse supports both ordinary
  # clones (.git directory) and linked worktrees (.git file).
  if [ -n "${DIESEL_REPO_ROOT:-}" ]; then
    ROOT="$(git -C "$DIESEL_REPO_ROOT" rev-parse --show-toplevel 2>/dev/null || true)"
  fi

  if [ -z "$ROOT" ]; then
    SCRIPT_DIR="$(cd "$(dirname "$0")" 2>/dev/null && pwd)"
    ROOT="$(git -C "$SCRIPT_DIR" rev-parse --show-toplevel 2>/dev/null || true)"
  fi

  if [ -z "$ROOT" ]; then
    ROOT="$(git -C "$PWD" rev-parse --show-toplevel 2>/dev/null || true)"
  fi

  if [ -z "$ROOT" ]; then
    for CANDIDATE in "$HOME/dieselbridge-project/repo" "$HOME/dieselbridge"; do
      if git -C "$CANDIDATE" rev-parse --show-toplevel >/dev/null 2>&1; then
        ROOT="$(git -C "$CANDIDATE" rev-parse --show-toplevel)"
        break
      fi
    done
  fi

  if [ -z "$ROOT" ]; then
    echo "ERROR: DieselBridge repo/worktree not found."
    echo "Run this tool from a DieselBridge checkout or set:"
    echo "  DIESEL_REPO_ROOT=/path/to/checkout"
    return 1
  fi

  cd "$ROOT" || return 1

  printf '\n===== PREFLIGHT =====\n'

  for CMD in git gh find; do
    if ! command -v "$CMD" >/dev/null 2>&1; then
      echo "ERROR: missing command: $CMD"
      return 1
    fi
  done

  if [ "$DOWNLOAD_ONLY" -ne 1 ] &&
     ! command -v adb >/dev/null 2>&1; then
    echo "ERROR: missing command: adb"
    return 1
  fi

  if [ "$OPEN_PHONE_INSTALLER" -eq 1 ] &&
     ! command -v termux-open >/dev/null 2>&1; then
    echo "ERROR: --open-phone-installer requires termux-open."
    return 1
  fi

  if ! gh auth status >/dev/null 2>&1; then
    echo "ERROR: GitHub CLI is not authenticated."
    echo "Run:"
    echo "  gh auth login"
    return 1
  fi

  if [ -n "$(git status --porcelain)" ]; then
    echo "ERROR: repository has uncommitted changes."
    echo
    git status --short
    echo
    echo "Commit/push or restore the current work before using this installer."
    return 1
  fi

  BRANCH="$(git branch --show-current)"
  HEAD="$(git rev-parse HEAD)"
  SHORT="$(git rev-parse --short=8 HEAD)"

  if [ -z "$BRANCH" ]; then
    echo "ERROR: detached HEAD."
    return 1
  fi

  echo "Branch: $BRANCH"
  echo "Commit: $HEAD"

  printf '\n===== VERIFY COMMIT IS PUSHED =====\n'

  REMOTE_HEAD="$(
    git ls-remote \
      origin \
      "refs/heads/$BRANCH" |
      awk '{print $1}'
  )"

  if [ -z "$REMOTE_HEAD" ]; then
    echo "ERROR: could not resolve origin/$BRANCH"
    return 1
  fi

  echo "Remote: $REMOTE_HEAD"

  if [ "$HEAD" != "$REMOTE_HEAD" ]; then
    echo "ERROR: local HEAD is not the pushed branch HEAD."
    echo
    echo "Local : $HEAD"
    echo "Remote: $REMOTE_HEAD"
    echo
    echo "Push first:"
    echo "  git push origin $BRANCH"
    return 1
  fi

  printf '\n===== WAIT FOR CI RUN =====\n'

  RUN_ID=""
  ATTEMPT=0

  while [ "$ATTEMPT" -lt 120 ]; do
    ATTEMPT=$((ATTEMPT + 1))

    RUN_ID="$(
      gh run list \
        --repo "$REPO" \
        --workflow "$WORKFLOW" \
        --commit "$HEAD" \
        --limit 20 \
        --json databaseId,headSha \
        --jq \
        'map(select(.headSha == "'"$HEAD"'")) | first | .databaseId // empty'
    )"

    if [ -n "$RUN_ID" ]; then
      break
    fi

    printf 'Waiting for GitHub Actions run... (%d)\r' \
      "$ATTEMPT"

    sleep 5
  done

  echo

  if [ -z "$RUN_ID" ]; then
    echo "ERROR: no CI run appeared for:"
    echo "  $HEAD"
    return 1
  fi

  echo "Run ID: $RUN_ID"

  RUN_SHA="$(
    gh run view \
      "$RUN_ID" \
      --repo "$REPO" \
      --json headSha \
      --jq '.headSha'
  )"

  if [ "$RUN_SHA" != "$HEAD" ]; then
    echo "ERROR: CI run SHA does not match current HEAD."
    echo "Expected: $HEAD"
    echo "Actual  : $RUN_SHA"
    return 1
  fi

  printf '\n===== LIVE CI =====\n'

  gh run watch \
    "$RUN_ID" \
    --repo "$REPO" \
    --interval 5 \
    --exit-status

  WATCH_RC=$?

  if [ "$WATCH_RC" -ne 0 ]; then
    printf '\n===== RESOLVE CI STATE =====\n'
    echo "gh run watch returned non-zero; resolving remote state before declaring failure."

    STATE_ATTEMPT=0
    RESOLVED=0

    while [ "$STATE_ATTEMPT" -lt 12 ]; do
      STATE_ATTEMPT=$((STATE_ATTEMPT + 1))

      RUN_STATE="$(
        gh run view \
          "$RUN_ID" \
          --repo "$REPO" \
          --json headSha,status,conclusion \
          --jq '[.headSha,.status,(.conclusion // "")] | @tsv' \
          2>/dev/null
      )"

      if [ -n "$RUN_STATE" ]; then
        STATE_SHA="$(printf '%s' "$RUN_STATE" | cut -f1)"
        STATE_STATUS="$(printf '%s' "$RUN_STATE" | cut -f2)"
        STATE_CONCLUSION="$(printf '%s' "$RUN_STATE" | cut -f3)"

        if [ "$STATE_SHA" != "$HEAD" ]; then
          echo "ERROR: CI state resolved to unexpected SHA."
          echo "Expected: $HEAD"
          echo "Actual  : $STATE_SHA"
          return 1
        fi

        echo "Remote status: $STATE_STATUS"
        echo "Remote result: ${STATE_CONCLUSION:-pending}"

        if [ "$STATE_STATUS" = "completed" ]; then
          RESOLVED=1
          break
        fi
      else
        echo "GitHub API unavailable ($STATE_ATTEMPT/12)."
      fi

      sleep 5
    done

    if [ "$RESOLVED" -ne 1 ]; then
      echo "ERROR: could not resolve authoritative CI state."
      return 1
    fi

    if [ "$STATE_CONCLUSION" != "success" ]; then
      printf '\n===== CI FAILED =====\n'
      gh run view "$RUN_ID" --repo "$REPO" --log-failed || true
      return 1
    fi

    echo "CI succeeded; continuing after the local network interruption."
  fi

  printf '\n===== CI SUCCESS =====\n'

  gh run view \
    "$RUN_ID" \
    --repo "$REPO" \
    --json \
      workflowName,headBranch,headSha,status,conclusion,url \
    --jq '
      "Workflow : \(.workflowName)\n" +
      "Branch   : \(.headBranch)\n" +
      "SHA      : \(.headSha)\n" +
      "Status   : \(.status)\n" +
      "Result   : \(.conclusion)\n" +
      "URL      : \(.url)"
    '

  if [ -n "${DIESEL_BUILD_ROOT:-}" ]; then
    BUILD_ROOT="$DIESEL_BUILD_ROOT"
  elif [ -d "$HOME/dieselbridge-project/artifacts" ]; then
    BUILD_ROOT="$HOME/dieselbridge-project/artifacts/builds"
  else
    BUILD_ROOT="$HOME/dieselbridge-builds"
  fi

  BUILD_DIR="$BUILD_ROOT/${SHORT}-run-${RUN_ID}"
  WATCH_DIR="$BUILD_DIR/watch"
  PHONE_DIR="$BUILD_DIR/phone"
  TEMP_DIR="$BUILD_DIR/.download-$$"

  printf '\n===== DOWNLOAD EXACT-SHA ARTIFACTS =====\n'
  echo "Build root: $BUILD_DIR"
  echo "Watch     : $WATCH_DIR"
  echo "Phone     : $PHONE_DIR"

  rm -rf "$TEMP_DIR"
  mkdir -p "$TEMP_DIR/watch" "$TEMP_DIR/phone"

  gh run download \
    "$RUN_ID" \
    --repo "$REPO" \
    --name "$WATCH_ARTIFACT" \
    --dir "$TEMP_DIR/watch"

  WATCH_DOWNLOAD_RC=$?

  if [ "$WATCH_DOWNLOAD_RC" -ne 0 ]; then
    rm -rf "$TEMP_DIR"
    echo "ERROR: watch artifact download failed."
    return "$WATCH_DOWNLOAD_RC"
  fi

  gh run download \
    "$RUN_ID" \
    --repo "$REPO" \
    --name "$PHONE_ARTIFACT" \
    --dir "$TEMP_DIR/phone"

  PHONE_DOWNLOAD_RC=$?

  if [ "$PHONE_DOWNLOAD_RC" -ne 0 ]; then
    rm -rf "$TEMP_DIR"
    echo "ERROR: phone artifact download failed."
    return "$PHONE_DOWNLOAD_RC"
  fi

  WATCH_APK_COUNT="$(
    find "$TEMP_DIR/watch" -type f -name '*.apk' |
      wc -l |
      tr -d '[:space:]'
  )"

  PHONE_APK_COUNT="$(
    find "$TEMP_DIR/phone" -type f -name '*.apk' |
      wc -l |
      tr -d '[:space:]'
  )"

  if [ "$WATCH_APK_COUNT" -ne 1 ]; then
    echo "ERROR: expected exactly one watch APK; found $WATCH_APK_COUNT"
    find "$TEMP_DIR/watch" -maxdepth 3 -type f
    rm -rf "$TEMP_DIR"
    return 1
  fi

  if [ "$PHONE_APK_COUNT" -ne 1 ]; then
    echo "ERROR: expected exactly one phone APK; found $PHONE_APK_COUNT"
    find "$TEMP_DIR/phone" -maxdepth 3 -type f
    rm -rf "$TEMP_DIR"
    return 1
  fi

  mkdir -p "$BUILD_DIR"
  rm -rf "$WATCH_DIR" "$PHONE_DIR"
  mv "$TEMP_DIR/watch" "$WATCH_DIR"
  mv "$TEMP_DIR/phone" "$PHONE_DIR"
  rmdir "$TEMP_DIR" 2>/dev/null || true

  WATCH_APK="$(find "$WATCH_DIR" -type f -name '*.apk' | head -n1)"
  PHONE_APK="$(find "$PHONE_DIR" -type f -name '*.apk' | head -n1)"

  printf '\n===== DOWNLOADED WATCH APK =====\n'
  echo "$WATCH_APK"
  ls -lh "$WATCH_APK"

  printf '\n===== DOWNLOADED PHONE APK =====\n'
  echo "$PHONE_APK"
  ls -lh "$PHONE_APK"

  if command -v sha256sum >/dev/null 2>&1; then
    printf '\nWatch SHA-256:\n'
    sha256sum "$WATCH_APK"
    printf '\nPhone SHA-256:\n'
    sha256sum "$PHONE_APK"
  fi

  PHONE_DOWNLOAD_COPY=""

  if [ -d "$HOME/storage/downloads" ]; then
    PHONE_DOWNLOAD_COPY="$HOME/storage/downloads/DieselBridge-Companion-${SHORT}.apk"
    cp -f "$PHONE_APK" "$PHONE_DOWNLOAD_COPY"

    printf '\n===== PHONE INSTALLER COPY =====\n'
    echo "$PHONE_DOWNLOAD_COPY"
    ls -lh "$PHONE_DOWNLOAD_COPY"
  else
    echo
    echo "NOTE: ~/storage/downloads is unavailable."
    echo "Run termux-setup-storage if you want an Android Downloads copy."
  fi

  if [ "$OPEN_PHONE_INSTALLER" -eq 1 ]; then
    if [ -z "$PHONE_DOWNLOAD_COPY" ]; then
      echo "ERROR: cannot open installer without ~/storage/downloads."
      return 1
    fi

    printf '\n===== OPEN PHONE INSTALLER =====\n'
    termux-open "$PHONE_DOWNLOAD_COPY"
  fi

  if [ "$DOWNLOAD_ONLY" -eq 1 ]; then
    printf '\n===== DOWNLOAD-ONLY COMPLETE =====\n'
    echo "Git SHA    : $HEAD"
    echo "CI run     : $RUN_ID"
    echo "Watch APK  : $WATCH_APK"
    echo "Phone APK  : $PHONE_APK"

    if [ -n "$PHONE_DOWNLOAD_COPY" ]; then
      echo "Phone copy : $PHONE_DOWNLOAD_COPY"
    fi

    return 0
  fi

  APK="$WATCH_APK"

  adb_connect_watch() {
    if [ -n "${DIESEL_ADB_SERIAL:-}" ]; then
      STATE="$(
        adb -s "$DIESEL_ADB_SERIAL" \
          get-state \
          2>/dev/null
      )"

      if [ "$STATE" = "device" ]; then
        ENDPOINT="$DIESEL_ADB_SERIAL"
        ADB_IP="${ENDPOINT%:*}"
        ADB_PORT="${ENDPOINT##*:}"

        echo
        echo "Using connected DIESEL_ADB_SERIAL:"
        echo "  $ENDPOINT"
        return 0
      fi
    fi

    EXISTING="$(
      adb devices |
        awk '
          NR > 1 &&
          $2 == "device" &&
          $1 ~ /^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+:[0-9]+$/ {
            print $1
            exit
          }
        '
    )"

    if [ -z "${ADB_IP:-}" ] &&
       [ -n "$EXISTING" ]; then
      ADB_IP="${EXISTING%:*}"
      ADB_PORT="${EXISTING##*:}"

      printf '\nExisting ADB watch: %s\n' "$EXISTING"
      printf 'Reuse it? [Y/n] '
      read -r REUSE

      case "$REUSE" in
        n|N|no|NO)
          ADB_IP=""
          ADB_PORT=""
          ;;
      esac
    fi

    while true; do
      printf '\n===== WATCH ADB CONNECTION =====\n'

      if [ -n "${ADB_IP:-}" ]; then
        printf 'Watch IP [%s]: ' "$ADB_IP"
      else
        printf 'Watch IP: '
      fi

      read -r NEW_IP

      if [ -n "$NEW_IP" ]; then
        ADB_IP="$NEW_IP"
      fi

      if [ -z "${ADB_IP:-}" ]; then
        echo "IP cannot be empty."
        continue
      fi

      if [ -n "${ADB_PORT:-}" ]; then
        printf 'ADB port [%s]: ' "$ADB_PORT"
      else
        printf 'ADB port: '
      fi

      read -r NEW_PORT

      if [ -n "$NEW_PORT" ]; then
        ADB_PORT="$NEW_PORT"
      fi

      if [ -z "${ADB_PORT:-}" ]; then
        echo "Port cannot be empty."
        continue
      fi

      ENDPOINT="$ADB_IP:$ADB_PORT"

      printf '\nConnecting to %s ...\n' "$ENDPOINT"

      adb connect "$ENDPOINT"

      sleep 1

      STATE="$(
        adb -s "$ENDPOINT" \
          get-state \
          2>/dev/null
      )"

      if [ "$STATE" = "device" ]; then
        echo "ADB connected: $ENDPOINT"
        return 0
      fi

      echo
      echo "ADB connection did not succeed."
      echo
      echo "Wear OS wireless-debugging ports can change."
      echo "Press Enter to retry the same IP/port, or type new values."
    done
  }

  ADB_IP=""
  ADB_PORT=""
  ENDPOINT=""

  adb_connect_watch || return 1

  printf '\n===== INSTALL WATCH APK =====\n'

  INSTALL_ATTEMPT=0
  INSTALL_OK=0

  while [ "$INSTALL_ATTEMPT" -lt 5 ]; do
    INSTALL_ATTEMPT=$((INSTALL_ATTEMPT + 1))

    printf '\nInstall attempt %d using %s\n' \
      "$INSTALL_ATTEMPT" \
      "$ENDPOINT"

    INSTALL_OUTPUT="$(
      adb -s "$ENDPOINT" \
        install -r "$APK" \
        2>&1
    )"

    INSTALL_RC=$?

    printf '%s\n' "$INSTALL_OUTPUT"

    if [ "$INSTALL_RC" -eq 0 ] &&
       printf '%s\n' "$INSTALL_OUTPUT" |
         grep -q 'Success'; then
      INSTALL_OK=1
      break
    fi

    case "$INSTALL_OUTPUT" in
      *"device offline"*|\
      *"device not found"*|\
      *"no devices/emulators found"*|\
      *"closed"*|\
      *"Connection reset"*|\
      *"cannot connect"*)
        echo
        echo "ADB connection was lost."
        echo "Reconnect using the current watch Wireless debugging endpoint."

        adb_connect_watch || return 1
        ;;

      *)
        echo
        echo "ERROR: installation failed for a non-connection reason."
        echo "Not retrying automatically."
        return 1
        ;;
    esac
  done

  if [ "$INSTALL_OK" -ne 1 ]; then
    echo "ERROR: install did not succeed after 5 attempts."
    return 1
  fi

  sleep 2

  printf '\n===== INSTALLED PACKAGE =====\n'

  adb -s "$ENDPOINT" \
    shell dumpsys package "$WATCH_PACKAGE" |
    grep -E \
      'versionCode=|versionName=|firstInstallTime=|lastUpdateTime='

  printf '\n===== BUILD USED =====\n'
  echo "Git SHA   : $HEAD"
  echo "CI run    : $RUN_ID"
  echo "Watch APK : $WATCH_APK"
  echo "Phone APK : $PHONE_APK"
  echo "ADB       : $ENDPOINT"

  if [ -n "$PHONE_DOWNLOAD_COPY" ]; then
    echo "Phone copy: $PHONE_DOWNLOAD_COPY"
  fi

  printf '\n===== DONE =====\n'
  echo "Watch APK installed successfully."
  echo "The exact-SHA companion APK was downloaded from the same CI run."

  if [ -n "$PHONE_DOWNLOAD_COPY" ]; then
    echo
    echo "Companion APK ready:"
    echo "  $PHONE_DOWNLOAD_COPY"
    echo
    echo "Open it with:"
    echo "  termux-open \"$PHONE_DOWNLOAD_COPY\""
  fi

  echo
  echo "Next useful watch test:"
  echo "  cd $ROOT"
  echo "  ./tools/diesel-adb '{\"cmd\":\"debug.build.info\"}'"

  return 0
}

diesel_ci_watch_download_install "$@"
