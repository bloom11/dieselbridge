#!/data/data/com.termux/files/usr/bin/bash

diesel_adb_main() {
  if [ "$#" -ne 1 ]; then
    echo "Usage:"
    echo "  diesel-adb '<Diesel request JSON>'"
    echo
    echo "Example:"
    echo "  diesel-adb '{\"cmd\":\"debug.build.info\"}'"
    return 2
  fi

  INPUT_JSON="$1"

  # Always use a new ID so an old logcat entry can never be mistaken
  # for the response to this invocation.
  REQUEST_ID="termux-$(date +%s)-$$-$RANDOM"

  REQUEST_JSON="$(
    printf '%s' "$INPUT_JSON" |
      python -c '
import json
import sys

request_id = sys.argv[1]

try:
    value = json.load(sys.stdin)
except Exception as error:
    raise SystemExit(
        f"ERROR: invalid request JSON: {error}"
    )

if not isinstance(value, dict):
    raise SystemExit(
        "ERROR: request must be a JSON object."
    )

cmd = value.get("cmd")

if not isinstance(cmd, str) or not cmd:
    raise SystemExit(
        "ERROR: request must contain a non-empty cmd."
    )

# Canonical Diesel v1 envelope.
value["t"] = "diesel"
value["v"] = 1
value["kind"] = "request"
value["id"] = request_id

if "args" not in value:
    value["args"] = {}

print(
    json.dumps(
        value,
        ensure_ascii=False,
        separators=(",", ":"),
    )
)
' "$REQUEST_ID"
  )"

  NORMALIZE_RC=$?

  if [ "$NORMALIZE_RC" -ne 0 ]; then
    return "$NORMALIZE_RC"
  fi

  if [ -n "$DIESEL_ADB_SERIAL" ]; then
    SERIAL="$DIESEL_ADB_SERIAL"
  else
    DEVICE_COUNT="$(
      adb devices |
        awk '
          NR > 1 && $2 == "device" {
            count++
          }

          END {
            print count + 0
          }
        '
    )"

    if [ "$DEVICE_COUNT" -ne 1 ]; then
      echo "ERROR: expected exactly one connected ADB device."
      adb devices
      echo
      echo "Or set:"
      echo "  export DIESEL_ADB_SERIAL='host:port'"
      return 1
    fi

    SERIAL="$(
      adb devices |
        awk '
          NR > 1 && $2 == "device" {
            print $1
            exit
          }
        '
    )"
  fi

  printf '\n===== WATCH =====\n'
  echo "$SERIAL"

  printf '\n===== REQUEST =====\n'
  echo "$REQUEST_JSON"

  printf '\n===== SEND THROUGH GADGETBRIDGE =====\n'

  am broadcast \
    -a com.banglejs.uart.tx \
    --es line "GB($REQUEST_JSON)"

  SEND_RC=$?

  if [ "$SEND_RC" -ne 0 ]; then
    echo "ERROR: outgoing Gadgetbridge broadcast failed."
    return "$SEND_RC"
  fi

  RESPONSE_DIR="${TMPDIR:-$HOME/.cache}"
  RESPONSE_LOG="$RESPONSE_DIR/diesel-adb-response-$$.log"

  mkdir -p "$RESPONSE_DIR"

  printf '\n===== WAIT FOR RESPONSE id=%s =====\n' \
    "$REQUEST_ID"

  FOUND=0
  ATTEMPT=0

  # 80 * 0.25s = 20 seconds.
  # This covers the current maximum 15-second sensor probe plus
  # BLE/Gadgetbridge transport margin.
  while [ "$ATTEMPT" -lt 80 ]; do
    ATTEMPT=$((ATTEMPT + 1))

    adb -s "$SERIAL" \
      logcat -d -v raw \
      -s DieselResponse:I '*:S' \
      > "$RESPONSE_LOG" \
      2>/dev/null

    if grep -Fq \
      "id=$REQUEST_ID " \
      "$RESPONSE_LOG"
    then
      FOUND=1
      break
    fi

    sleep 0.25
  done

  if [ "$FOUND" -ne 1 ]; then
    echo "ERROR: no matching Diesel response mirror observed."

    printf '\n===== WATCH DIAGNOSTIC LINES =====\n'

    adb -s "$SERIAL" logcat -d -v time |
      grep -F "$REQUEST_ID" |
      tail -40

    rm -f "$RESPONSE_LOG"
    return 1
  fi

  printf '\n===== RESPONSE =====\n'

  python \
    - "$REQUEST_ID" "$RESPONSE_LOG" \
    <<'DIESEL_ADB_PARSE_PY'
import base64
import json
import re
import sys


request_id = sys.argv[1]
path = sys.argv[2]

prefix = f"id={request_id} "

single = []
parts = {}
expected_parts = None


with open(
    path,
    encoding="utf-8",
    errors="replace",
) as handle:
    for raw in handle:
        line = raw.rstrip("\r\n")

        if not line.startswith(prefix):
            continue

        rest = line[len(prefix):]

        single_match = re.fullmatch(
            r"encoding=base64 data=(.*)",
            rest,
        )

        if single_match:
            single.append(
                single_match.group(1)
            )
            continue

        part_match = re.fullmatch(
            r"part=(\d+)/(\d+) encoding=base64 data=(.*)",
            rest,
        )

        if not part_match:
            continue

        index = int(
            part_match.group(1)
        )

        total = int(
            part_match.group(2)
        )

        data = part_match.group(3)

        if expected_parts is None:
            expected_parts = total

        elif expected_parts != total:
            raise SystemExit(
                "ERROR: inconsistent response chunk count."
            )

        parts[index] = data


if single:
    encoded = single[-1]

elif parts:
    if expected_parts is None:
        raise SystemExit(
            "ERROR: response chunk count missing."
        )

    missing = [
        index
        for index in range(
            1,
            expected_parts + 1,
        )
        if index not in parts
    ]

    if missing:
        raise SystemExit(
            "ERROR: missing response chunks: " +
            ", ".join(
                map(
                    str,
                    missing,
                )
            )
        )

    encoded = "".join(
        parts[index]
        for index in range(
            1,
            expected_parts + 1,
        )
    )

else:
    raise SystemExit(
        "ERROR: matching DieselResponse lines could not be parsed."
    )


try:
    payload = base64.b64decode(
        encoded,
        validate=True,
    )
except Exception as error:
    raise SystemExit(
        f"ERROR: invalid Base64 response: {error}"
    )


try:
    text = payload.decode(
        "utf-8",
    )
except UnicodeDecodeError as error:
    raise SystemExit(
        f"ERROR: response was not UTF-8: {error}"
    )


try:
    response = json.loads(
        text,
    )
except Exception as error:
    print(text)

    raise SystemExit(
        f"ERROR: response was not valid JSON: {error}"
    )


if response.get("id") != request_id:
    raise SystemExit(
        "ERROR: reconstructed response id does not match request."
    )


print(
    json.dumps(
        response,
        indent=2,
        ensure_ascii=False,
    )
)
DIESEL_ADB_PARSE_PY

  RESULT=$?

  rm -f "$RESPONSE_LOG"

  return "$RESULT"
}

diesel_adb_main "$@"
