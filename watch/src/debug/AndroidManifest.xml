<?xml version="1.0" encoding="utf-8"?>
<!-- DEBUG-ONLY overlay: ADB/developer receivers. Never present in release builds. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <receiver
            android:name=".debug.DebugInjectReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="org.aaustralian.dieselbridge.INJECT" />
            </intent-filter>
        </receiver>

        <!--
            DEBUG-ONLY explicit ADB control surface for the service-owned
            SensorObservationSmokeRunner. The receiver never owns sensors and
            never enters the public Diesel protocol/BLE path.
        -->
        <receiver
            android:name=".debug.DebugObservationSmokeReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="org.aaustralian.dieselbridge.OBSERVATION_SMOKE" />
            </intent-filter>
        </receiver>

        <!-- DEBUG-only and read-only: stock Gadgetbridge still owns t:"act" control. -->
        <receiver
            android:name=".debug.DebugGadgetbridgeActivityReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="org.aaustralian.dieselbridge.GADGETBRIDGE_ACTIVITY_STATUS" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
