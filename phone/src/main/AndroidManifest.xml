<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      M6+ intentionally declares no Bluetooth, exact-alarm, foreground-service
      or location permissions. Stock Gadgetbridge remains the sole phone BLE
      owner. The normal-level public API permission is explicit opt-in, while
      per-command policy remains the actual capability boundary.
    -->
    <permission
        android:name="io.github.bloom11.dieselbridge.phone.permission.USE_DIESEL_PHONE_API"
        android:protectionLevel="normal" />

    <application
        android:name=".DieselBridgePhoneApplication"
        android:allowBackup="false"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".gateway.PhoneDieselInboundReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="io.github.bloom11.dieselbridge.DIESEL_MESSAGE" />
            </intent-filter>
        </receiver>

        <service
            android:name=".ipc.PhoneDieselPublicService"
            android:exported="true"
            android:permission="io.github.bloom11.dieselbridge.phone.permission.USE_DIESEL_PHONE_API" />

    </application>
</manifest>
